#!/bin/sh
# Refuse a Mac the binaries cannot run on, before anything is unpacked. The
# build substitutes @ARCH@ (build-pkg.sh); Go needs macOS 12 or later.
set -eu

want=@ARCH@
arch=$(uname -m)
if [ "$arch" != "$want" ]; then
	echo "weave-agent: this package is for $want Macs; this one is $arch" >&2
	exit 1
fi
major=$(sw_vers -productVersion | cut -d. -f1)
if [ "$major" -lt 12 ]; then
	echo "weave-agent: needs macOS 12 or later; this is $(sw_vers -productVersion)" >&2
	exit 1
fi
exit 0
