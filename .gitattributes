# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto eol=lf

# LF everywhere, Windows checkouts included: gofmt and the linters treat a
# CRLF Go file as unformatted, so a Windows CI lane would fail on every file.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

*.json text eol=lf
